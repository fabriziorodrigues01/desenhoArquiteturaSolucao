@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title C4 Nível 2: Diagrama de Containers - Ecossistema de Gestão de Limites (AWS Region)

' Atores e Sistemas Externos
Person(customer, "Cliente", "App / Web / Call Center")

System_Ext(risk_saas, "Motor de Risco", "SaaS Externo", "Validação de crédito e políticas de risco")
System_Ext(push_svc, "Push Notification", "SNS/FCM", "Notificações push em tempo real")
System_Ext(brand, "Bandeira (Visa/Master)", "External API", "Atualização de saldo STIP / Offline")

' Região AWS
System_Boundary(aws_region, "AWS Region (sa-east-1)") {

    System_Boundary(cicd, "DevSecOps (CI/CD)") {
        Container(pipeline, "Pipeline de Deploy", "CodeCommit/Build/Helm", "Orquestra a entrega do código Java refatorado")
    }

    System_Boundary(edge_security, "Borda") {
	Container(apigw, "API Gateway", "AWS Gateway", "Entrypoint")
    }
        
    System_Boundary(compute, "Compute Layer (Amazon EKS)") {
        Container(pod_limit, "Pod A: Gestor de Limites", "Java / Spring", "Orquestra workflow, Idempotência e Risco")     
    }

    System_Boundary(storage, "State & Data Layer") {
        ContainerDb(redis, "ElastiCache (Redis)", "Redis OSS", "State Store: Idempotência e Saldo Projetado")
        ContainerDb(dynamo, "DynamoDB (Global Tables)", "NoSQL", "Ledger oficial com PITR e DR Regional")
    }

    System_Boundary(integration, "Resilience & Integration") {
        Container(lambda, "Integration Worker", "AWS Lambda", "Worker assíncrono orientado a eventos (CDC)")
        ContainerQueue(sqs, "Amazon SQS FIFO", "SQS", "Buffer para isolar falhas no Direct Connect")
    }

    
}

' Conectividade e On-Premise
System_Boundary(onprem_connectivity, "Legacy Connectivity") {
    Container(dx, "Direct Connect / VPN", "Network", "Túnel seguro para o Data Center")
    ContainerDb(legacy, "(Legado)", "MF/Open", "Sistema de registro final (800ms latência)")
}

' Relacionamentos
Rel(pipeline, pod_limit, "Rolling Update")
Rel(customer, apigw, "Solicita Ajuste", "HTTPS/JSON")
Rel(apigw, pod_limit, "Encaminha Request", "gRPC/REST")

' Fluxo com Sistemas Externos
Rel(pod_limit, risk_saas, "1. Valida Risco", "HTTPS/JSON")
Rel(pod_limit, redis, "2. Lock & Idempotência", "Redis Proto")
Rel(pod_limit, dynamo, "3. Persistência (PENDING)", "DynamoDB SDK")
Rel(pod_limit, push_svc, "4. Notifica Início", "SNS")

' Fluxo Assíncrono
Rel(dynamo, lambda, "DynamoDB Streams (CDC)")
Rel(lambda, sqs, "Garante Ordem", "SQS FIFO")
Rel(sqs, dx, "Consumo Controlado")
Rel(dx, legacy, "Sincroniza Legado")
Rel(dx, brand, "Sincroniza Bandeira (STIP)")
Rel(lambda, push_svc, "5. Notifica Sucesso", "SNS")
@enduml