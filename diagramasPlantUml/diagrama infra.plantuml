@startuml
!theme plain
skinparam componentStyle uml2
title Arquitetura de Infraestrutura Cloud - Gestão de Limites (AWS Region & Ecosystem)

package "Clients & Channels" {
    [App / Web / Call Center] as channels #White
}

package "External Systems (SaaS/Partners)" {
    [Motor de Risco (SaaS)] as risk #Lavender
    [Push Notification (SNS/FCM)] as push #Cornsilk
    [Bandeira (Visa/Mastercard)] as card_brand #Ivory
}

package "AWS Region (sa-east-1)" {

    package "DevSecOps (CI/CD)" {
        [Pipeline: CodeCommit/Build/ECR/Helm] as pipeline #LightBlue
    }

    package "Compute Layer (Amazon EKS)" {
        [Amazon API Gateway] as apigw #GhostWhite
        [Pod A: Gestor de Limites (Java)] as limit_svc #White
        [Pod B: Autorizador de Saldo (Java)] as auth_svc #White
    }

    package "State & Data Layer" {
        database "Redis (ElastiCache)" as redis #LightCoral
        database "DynamoDB (Global Tables)" as dynamo #LightCoral
        [DynamoDB Streams] as streams #LightCoral
    }

    package "Resilience & Integration" {
        queue "Amazon SQS (FIFO)" as sqs #LightGreen
        [Integration Worker (Lambda)] as worker #White
    }
}

package "Legacy Connectivity" {
    [Direct Connect / VPN] as dx #Ivory
    database "(Legacy)" as mainframe #Grey
}

' Fluxo CI/CD
pipeline -down-> limit_svc : "Rolling Update"

' Fluxo Principal (Canais)
channels -down-> apigw
apigw -down-> limit_svc

' Validações Externas (Síncronas)
limit_svc -right-> risk : "1. Valida Risco"
limit_svc -left-> push : "4. Notifica Início"

' Lógica de Dados
limit_svc -down-> redis : "2. Lock & Idempotência"
limit_svc -down-> dynamo : "3. Persistência (PENDING)"

' Sincronismo Assíncrono
dynamo -down-> streams
streams -down-> worker
worker -down-> sqs
sqs -down-> dx

' Destinos Finais (Legado e Bandeira)
dx -down-> mainframe : "Sincroniza Legado"
dx -down-> card_brand : "Update STIP"
worker -up-> push : "5. Notifica Sucesso"

' Autorização
auth_svc -up-> redis : "Consulta Saldo Projetado"

note bottom of "AWS Region (sa-east-1)"
  **Resiliência Regional:**
  - DynamoDB Global Tables (DR)
  - Multi-AZ Deployment para EKS e Redis
  - Escalabilidade Automática (HPA/On-Demand)
end note

@enduml
